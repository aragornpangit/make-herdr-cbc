             Some(Agent::Letta) => self.letta,
             Some(Agent::Maki) => self.maki,
             Some(Agent::Muse) => self.muse,
+            Some(Agent::Codebuddy) => AgentSoundSetting::Default,
             None => AgentSoundSetting::Default,
         }
     }
